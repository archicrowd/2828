\pard\sa160\sb0\sl276\slmult1\li0\fs18 {\i Durchschnitt der zehn Staaten; Euro im Jahr, 2028, nominal.\i0}\par
\pard\keepn\sb220\sa100\fs24\b\cf1 6.2  Der Zeitpfad\b0\cf0\par
